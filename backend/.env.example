# Copy to .env and adjust as needed. All values have safe defaults in app/config.py.

# PHISH_DATABASE_URL=sqlite:///./phishing.db
# PHISH_CHECK_TIMEOUT_SECONDS=6.0
# PHISH_NETWORK_TIMEOUT_SECONDS=3.5
# PHISH_CACHE_TTL_HOURS=24

# Optional: enables a ground-truth check against Google's Safe Browsing
# threat list on top of this app's own model. Without it, the app runs
# fully self-contained -- this one extra layer is just turned off.
# Free key: console.cloud.google.com -> enable "Safe Browsing API" ->
# Credentials -> Create API key. See app/features/reputation.py for details.
# PHISH_SAFE_BROWSING_API_KEY=

# Optional: enables a second, independent ground-truth check --
# VirusTotal's 70+-engine URL reputation consensus. Without it, the app
# runs fully self-contained -- this one extra layer is just turned off.
# Free key: create an account at virustotal.com, then copy your key from
# virustotal.com/gui/my-apikey. Free tier is heavily rate-limited (4
# requests/minute, 500/day) -- fine for personal use. See
# app/features/reputation.py for details.
# PHISH_VIRUSTOTAL_API_KEY=
# PHISH_VIRUSTOTAL_MALICIOUS_THRESHOLD=3

# Optional: enables an AI-generated one-line "what is this site" summary in
# the UI (purely informational, never feeds the verdict). Without it, the
# description is simply omitted. Free key: aistudio.google.com/apikey.
# See app/features/description.py for details.
# PHISH_GEMINI_API_KEY=
# PHISH_GEMINI_MODEL=gemini-2.5-flash
