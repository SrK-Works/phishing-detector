# Copy to .env and adjust as needed. All values have safe defaults in app/config.py.

# PHISH_DATABASE_URL=sqlite:///./phishing.db
# PHISH_CHECK_TIMEOUT_SECONDS=6.0
# PHISH_NETWORK_TIMEOUT_SECONDS=3.5
# PHISH_CACHE_TTL_HOURS=24

# Optional: enables a ground-truth check against Google's Safe Browsing
# threat list on top of this app's own model. Without it, the app runs
# fully self-contained -- this one extra layer is just turned off.
# Free key: console.cloud.google.com -> enable "Safe Browsing API" ->
# Credentials -> Create API key. See app/features/reputation.py for details.
# PHISH_SAFE_BROWSING_API_KEY=
