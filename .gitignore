# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Backend data/artifacts (built, not committed as source)
backend/phishing.db
backend/app/model/artifacts/*.joblib
backend/app/model/artifacts/*.json
backend/app/data/tranco.csv
backend/app/data/*.zip
backend/static_frontend/

# dataset.parquet itself IS committed (see below) as the frozen,
# network-free source of truth for training -- only dated snapshots and
# other generated parquet files stay ignored.
backend/app/data/*.parquet
!backend/app/data/dataset.parquet

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/

# Env / secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
